---
import { ui, type Lang } from '../i18n/ui';
const { lang } = Astro.props as { lang: Lang };
const t = ui[lang].services;
const cardBg = [
  'linear-gradient(145deg,#1B4B8F,#0C2647)',
  'linear-gradient(145deg,#7C3AED,#4F46E5)',
  'linear-gradient(145deg,#E8244C,#A81433)'
];
const hover = ['hover:bg-navy-soft', 'hover:bg-[#F3F0FE]', 'hover:bg-crimson-soft'];
const chip = ['bg-navy-soft text-navy', 'bg-[#F3F0FE] text-[#4F46E5]', 'bg-crimson-soft text-crimson'];
---
<section id="services" class="bg-page">
  <div class="mx-auto max-w-6xl px-5 py-20 reveal">
    <div class="text-center max-w-2xl mx-auto">
      <span class="inline-block bg-white border border-line text-navy text-[12px] font-semibold px-3.5 py-1.5 rounded-full">{t.badge}</span>
      <h2 class="mt-5 text-[34px] lg:text-[42px] font-extrabold text-navy">{t.title}</h2>
      <p class="mt-3 text-[15px] text-muted">{t.subtitle}</p>
    </div>

    <div class="mt-12 grid md:grid-cols-3 gap-6 items-start">
      {t.pillars.map((p, i) => (
        <div>
          <div class="rounded-2xl p-7 text-white shadow-lg" style={`background:${cardBg[i]}`}>
            <span class="w-11 h-11 grid place-items-center rounded-xl bg-white/15 text-[17px] mb-5">{p.icon}</span>
            <h3 class="text-[19px] font-bold mb-2">{p.title}</h3>
            <p class="text-[13px] leading-relaxed text-white/75 mb-5">{p.text}</p>
            <button type="button" onclick={`togglePillar('pillar-${i}')`} class="bg-white/15 hover:bg-white/25 text-[13px] font-semibold px-4 py-2 rounded-lg transition">{t.view} ⌄</button>
          </div>

          <div id={`pillar-${i}`} class="pillar-list">
            <div class="bg-white border border-line rounded-2xl mt-3 p-3 space-y-1 shadow-sm">
              {p.items.map((it) => (
                <div class={`flex gap-3 items-center p-2.5 rounded-lg ${hover[i]}`}>
                  <span class={`w-8 h-8 grid place-items-center rounded-md text-[13px] ${chip[i]}`}>{it.icon}</span>
                  <div>
                    <p class="text-[13px] font-semibold text-navy">{it.name}</p>
                    <p class="text-[11px] text-muted">{it.desc}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
