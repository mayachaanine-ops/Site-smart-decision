---
import { ui, company, type Lang } from '../i18n/ui';
const { lang } = Astro.props as { lang: Lang };
const t = ui[lang].contact;
---
<section id="contact" class="bg-white">
  <div class="mx-auto max-w-6xl px-5 py-20 reveal">
    <div class="text-center max-w-2xl mx-auto">
      <span class="inline-block bg-navy-soft text-navy text-[12px] font-semibold px-3.5 py-1.5 rounded-full">{t.badge}</span>
      <h2 class="mt-5 text-[34px] lg:text-[42px] font-extrabold text-navy">{t.title}</h2>
      <p class="mt-3 text-[15px] text-muted">{t.subtitle}</p>
    </div>

    <div class="mt-12 grid lg:grid-cols-2 gap-6">
      <div class="bg-white border border-line rounded-2xl p-7 shadow-sm">
        <h3 class="text-[18px] font-bold text-navy mb-5">{t.formTitle}</h3>
        <form class="space-y-4" method="POST" action="/api/contact">
          <div>
            <label class="block text-[13px] font-medium mb-1.5" for="f-nom">{t.name} <span class="text-crimson">*</span></label>
            <input id="f-nom" name="nom" required class="w-full border border-line bg-[#F8FAFC] rounded-lg px-3.5 py-2.5 text-[14px]" placeholder="Jean Dupont" />
          </div>
          <div>
            <label class="block text-[13px] font-medium mb-1.5" for="f-mail">{t.email} <span class="text-crimson">*</span></label>
            <input id="f-mail" name="email" type="email" required class="w-full border border-line bg-[#F8FAFC] rounded-lg px-3.5 py-2.5 text-[14px]" placeholder="jean@exemple.com" />
          </div>
          <div>
            <label class="block text-[13px] font-medium mb-1.5" for="f-tel">{t.phone}</label>
            <input id="f-tel" name="telephone" class="w-full border border-line bg-[#F8FAFC] rounded-lg px-3.5 py-2.5 text-[14px]" placeholder="06 00 00 00 00" />
          </div>
          <div>
            <label class="block text-[13px] font-medium mb-1.5" for="f-msg">{t.message} <span class="text-crimson">*</span></label>
            <textarea id="f-msg" name="message" rows="4" required class="w-full border border-line bg-[#F8FAFC] rounded-lg px-3.5 py-2.5 text-[14px]"></textarea>
          </div>
          <div class="flex gap-3 pt-1">
            <button type="submit" class="flex-1 bg-navy hover:bg-navy-deep text-white font-semibold text-[14px] py-3 rounded-lg transition">{t.send}</button>
            <button type="button" class="border border-crimson text-crimson hover:bg-crimson-soft font-semibold text-[14px] px-5 py-3 rounded-lg transition">{t.bot}</button>
          </div>
        </form>
      </div>

      <div class="space-y-4">
        <div class="rounded-2xl p-7 text-white" style="background:linear-gradient(150deg,#1B4B8F,#0C2647)">
          <h3 class="text-[18px] font-bold mb-5">{t.infoTitle}</h3>
          <div class="space-y-3">
            <a href={`mailto:${company.email}`} class="flex items-center gap-3 bg-white/10 rounded-xl p-3.5">
              <span class="w-9 h-9 grid place-items-center rounded-lg bg-white/15">✉</span>
              <span><span class="block text-[11px] text-white/60">{t.labelMail}</span><span class="block text-[14px] font-semibold">{company.email}</span></span>
            </a>
            <a href={`tel:${company.phone.replace(/\./g, '')}`} class="flex items-center gap-3 bg-white/10 rounded-xl p-3.5">
              <span class="w-9 h-9 grid place-items-center rounded-lg bg-white/15">☎</span>
              <span><span class="block text-[11px] text-white/60">{t.labelPhone}</span><span class="block text-[14px] font-semibold">{company.phone}</span></span>
            </a>
            <div class="flex items-center gap-3 bg-white/10 rounded-xl p-3.5">
              <span class="w-9 h-9 grid place-items-center rounded-lg bg-white/15">⌖</span>
              <span><span class="block text-[11px] text-white/60">{t.labelAddress}</span><span class="block text-[14px] font-semibold">{company.address}</span></span>
            </div>
          </div>
        </div>

        <div class="rounded-2xl p-7 text-center text-white" style="background:linear-gradient(135deg,#E8244C,#A81433)">
          <p class="text-[19px] font-bold mb-1.5">{t.ctaTitle}</p>
          <p class="text-[13px] text-white/85 mb-5">{t.ctaText}</p>
          <a href="#" class="inline-block bg-white text-crimson font-bold text-[14px] px-7 py-3 rounded-lg">{t.ctaBtn}</a>
        </div>
      </div>
    </div>
  </div>
</section>
