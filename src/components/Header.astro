---
import { ui, type Lang } from '../i18n/ui';
const { lang } = Astro.props as { lang: Lang };
const t = ui[lang].nav;
const other = lang === 'fr' ? 'en' : 'fr';
---
<header class="sticky top-0 z-50 bg-white/90 backdrop-blur border-b border-line">
  <div class="mx-auto max-w-6xl px-5 h-[70px] flex items-center justify-between gap-4">
    <a href={`/${lang}/`} class="flex items-center gap-2">
      <svg width="26" height="26" viewBox="0 0 26 26" aria-hidden="true">
        <circle cx="7" cy="6" r="3" fill="#DC1E45" />
        <circle cx="19" cy="12" r="3" fill="#123A6E" />
        <circle cx="9" cy="20" r="3" fill="#123A6E" />
        <path d="M7 6 L19 12 L9 20" stroke="#123A6E" stroke-width="1.2" fill="none" opacity=".5" />
      </svg>
      <span class="display font-extrabold text-[17px] text-navy">Smart<span class="text-crimson"> Decision</span></span>
    </a>

    <nav class="hidden lg:flex items-center gap-7 text-[14px] font-medium text-muted">
      <a href={`/${lang}/`} class="text-navy relative after:absolute after:-bottom-2 after:left-0 after:h-[2px] after:w-full after:bg-crimson">{t.home}</a>
      <a href="#apropos" class="hover:text-navy">{t.about}</a>
      <a href="#services" class="hover:text-navy">{t.services}</a>
      <a href="#portfolio" class="hover:text-navy">{t.portfolio}</a>
      <a href="#blog" class="hover:text-navy">{t.blog}</a>
      <a href="#contact" class="hover:text-navy">{t.contact}</a>
    </nav>

    <div class="flex items-center gap-3">
      <a href={`/${other}/`} class="text-[13px] font-semibold text-muted border border-line rounded-full px-3 py-1.5 hover:border-navy hover:text-navy">
        {other.toUpperCase()}
      </a>
      <a href="#contact" class="hidden sm:inline-block bg-navy hover:bg-navy-deep text-white text-[14px] font-semibold px-5 py-2.5 rounded-lg transition">{t.demo}</a>
    </div>
  </div>
</header>
